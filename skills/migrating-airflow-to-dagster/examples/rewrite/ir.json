       "name": "reshape",
       "module": "unusual_prefix_fe4965ea2b0dd5558582e422850ae884dbae0f18_partner_ingest",
       "source": "@task\ndef reshape(rows: list[dict]) -> dict:\n    \"\"\"One record per customer, amounts summed, rows without an id dropped.\"\"\"\n    out: dict[str, float] = {}\n    for r in rows:\n        if r.get(\"customer_id\"):\n            out[r[\"customer_id\"]] = out.get(r[\"customer_id\"], 0.0) + float(r.get(\"amount\", 0))\n    return {\"customers\": len(out), \"total\": round(sum(out.values()), 2), \"by_customer\": out}\n",
       "file": "/opt/airflow/dags/partner_ingest.py",
       "params": [
        "rows"
       ]
      }
     },
