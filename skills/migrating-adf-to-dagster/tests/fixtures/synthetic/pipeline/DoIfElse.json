{
  "name": "DoIfElse",
  "properties": {
    "parameters": {
      "mode": {
        "type": "String",
        "defaultValue": "ok"
      }
    },
    "variables": {
      "v": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "A",
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@equals(pipeline().parameters.mode, 'fail')",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Boom",
              "type": "Fail",
              "typeProperties": {
                "message": "boom",
                "errorCode": "X"
              }
            }
          ],
          "ifFalseActivities": []
        }
      },
      {
        "name": "Catch",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "A",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "variableName": "v",
          "value": "caught"
        }
      },
      {
        "name": "Next",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "A",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "variableName": "v",
          "value": "next"
        }
      }
    ]
  }
}