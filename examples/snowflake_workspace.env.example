# Example .env for the Dagster Snowflake demo. SAFE TO COMMIT.
# Copy to .env and replace the placeholders, OR re-run seed.sh.

# ── Snowflake connection ────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<your-account-locator>          # e.g. xy12345.us-east-1 or org-account
SNOWFLAKE_USER=<your-username>
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=DAGSTER_RUNNER                     # scoped role seed.sh creates
SNOWFLAKE_DATABASE=DAGSTER_DEMO
SNOWFLAKE_SCHEMA=STAGING
SNOWFLAKE_AUTH_METHOD=keypair                     # keypair | pat | password | password_mfa | sso

# Pick ONE auth-credentials block depending on SNOWFLAKE_AUTH_METHOD:
# (a) keypair — recommended for production/dg dev daemon
SNOWFLAKE_PRIVATE_KEY_FILE=~/.ssh/snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=<passphrase-if-encrypted>

# (b) password
# SNOWFLAKE_PASSWORD=<password>

# (c) PAT
# SNOWFLAKE_PAT=<programmatic-access-token>

# ── Iceberg (optional) ──────────────────────────────────────────
# ICEBERG_EXTERNAL_VOLUME=DAGSTER_DEMO_VOLUME
# ICEBERG_S3_BUCKET=<your-bucket>
# ICEBERG_ROLE_ARN=arn:aws:iam::<account>:role/<role-name>

# ── Snowpipe S3 staging (optional, set by seed.sh when AWS+Iceberg) ─
# S3_STAGING_BUCKET=<same-bucket-as-iceberg>
# S3_STAGING_PREFIX=orders/
# SNOWPIPE_STORAGE_INTEGRATION=DAGSTER_DEMO_S3_INTEGRATION

# ── Demo content metadata (set by seed.sh; bootstrap.sh reads) ──
SEED_HAS_DYNAMIC_TABLE=true
SEED_HAS_TASK=true
SEED_HAS_AI_TABLE=true
# SEED_HAS_ICEBERG_VOLUME=true
